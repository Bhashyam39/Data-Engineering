# ============================================
# DATA & SECRETS (Critical for DE work)
# ============================================
# Never commit raw data files
*.csv
*.tsv
*.json
*.parquet
*.avro
*.xlsx
*.xls
*.db
*.sqlite
*.sqlite3

# Never commit secrets or config with passwords
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/
config.local.yml
config.local.yaml

